"use strict";

const menuToggle = document.getElementById("menuToggle");
const mainNav = document.getElementById("mainNav");

function closeMobileMenu() {
  if (!menuToggle || !mainNav) return;
  mainNav.classList.remove("open");
  menuToggle.setAttribute("aria-expanded", "false");
  menuToggle.setAttribute("aria-label", "Abrir menú");
}

if (menuToggle && mainNav) {
  menuToggle.addEventListener("click", () => {
    const isOpen = mainNav.classList.toggle("open");
    menuToggle.setAttribute("aria-expanded", String(isOpen));
    menuToggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
  });

  mainNav.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMobileMenu();
  });

  document.addEventListener("click", (event) => {
    if (!mainNav.contains(event.target) && !menuToggle.contains(event.target)) {
      closeMobileMenu();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 700) closeMobileMenu();
  });
}

const year = document.getElementById("year");
if (year) year.textContent = new Date().getFullYear();

const form = document.getElementById("contactForm");

function collectQuoteData() {
  if (!form || !form.reportValidity()) return null;
  const data = new FormData(form);
  return {
    name: String(data.get("name") || "").trim(),
    email: String(data.get("clientEmail") || "").trim(),
    phone: String(data.get("clientPhone") || "").trim(),
    service: String(data.get("service") || "").trim(),
    message: String(data.get("message") || "").trim()
  };
}

function buildQuoteMessage(quote) {
  return [
    "Solicitud de cotización - Balance Administrativo",
    "",
    `Nombre o empresa: ${quote.name}`,
    `Correo del cliente: ${quote.email || "No indicado"}`,
    `Teléfono: ${quote.phone || "No indicado"}`,
    `Servicio solicitado: ${quote.service}`,
    `Detalle: ${quote.message || "Solicito más información sobre este servicio."}`,
    "",
    "Enviado desde el sitio web de Balance Administrativo."
  ].join("\n");
}

if (form) {
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const quote = collectQuoteData();
    if (!quote) return;
    const whatsappUrl = `https://wa.me/50661119094?text=${encodeURIComponent(buildQuoteMessage(quote))}`;
    window.open(whatsappUrl, "_blank", "noopener,noreferrer");
  });

  const emailButton = document.getElementById("sendEmailQuote");
  if (emailButton) {
    emailButton.addEventListener("click", () => {
      const quote = collectQuoteData();
      if (!quote) return;
      const subject = `Solicitud de cotización - ${quote.service}`;
      const mailtoUrl = `mailto:info@balanceadministrativo.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(buildQuoteMessage(quote))}`;
      window.location.href = mailtoUrl;
    });
  }
}
</script>
